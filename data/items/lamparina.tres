[gd_resource type="Resource" load_steps=4 format=3]

[ext_resource type="Script" path="res://resources/item_data.gd" id="1_item"]
[ext_resource type="Script" path="res://resources/stat_modifier.gd" id="2_mod"]

[sub_resource type="Resource" id="mod_oil"]
script = ExtResource("2_mod")
stat = &"max_oil"
mode = 0
value = 30.0

[sub_resource type="Resource" id="mod_focus"]
script = ExtResource("2_mod")
stat = &"light_oil_per_second"
mode = 1
value = 1.2

[resource]
script = ExtResource("1_item")
id = &"lamparina"
display_name = "Lamparina"
description = "+30 de óleo máximo e focos recarregam 20% mais rápido."
rarity = 1
tags = [&"oleo"]
modifiers = [SubResource("mod_oil"), SubResource("mod_focus")]
max_stacks = 2