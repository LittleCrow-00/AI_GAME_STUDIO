[sub_resource type="Resource" id="mod_damage"]
script = ExtResource("2_mod")
stat = &"beam_damage"
mode = 1
value = 0.9

[resource]
script = ExtResource("1_item")
id = &"oleo_velho"
display_name = "Óleo Velho"
description = "Gasta 15% menos óleo, mas queima 10% mais fraco."
