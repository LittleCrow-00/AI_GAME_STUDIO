[gd_resource type="Resource" load_steps=4 format=3]

[ext_resource type="Script" path="res://resources/item_data.gd" id="1_item"]
[ext_resource type="Script" path="res://resources/stat_modifier.gd" id="2_mod"]

[sub_resource type="Resource" id="mod_dash"]
script = ExtResource("2_mod")
stat = &"dash_charges_max"
mode = 0
value = 1.0

[sub_resource type="Resource" id="mod_speed"]
script = ExtResource("2_mod")
stat = &"move_speed"
mode = 1
value = 0.9

[resource]
script = ExtResource("1_item")
id = &"bota_de_couro"
display_name = "Bota de Couro"
description = "+1 carga de dash, mas você se move 10% mais devagar."
rarity = 1
tags = [&"corpo"]
modifiers = [SubResource("mod_dash"), SubResource("mod_speed")]
max_stacks = 1