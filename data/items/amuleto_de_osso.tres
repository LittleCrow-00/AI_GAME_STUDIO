[gd_resource type="Resource" load_steps=4 format=3]

[ext_resource type="Script" path="res://resources/item_data.gd" id="1_item"]
[ext_resource type="Script" path="res://resources/stat_modifier.gd" id="2_mod"]

[sub_resource type="Resource" id="mod_health"]
script = ExtResource("2_mod")
stat = &"max_health"
mode = 0
value = 30.0

[sub_resource type="Resource" id="mod_speed"]
script = ExtResource("2_mod")
stat = &"move_speed"
mode = 1
value = 0.9

[resource]
script = ExtResource("1_item")
id = &"amuleto_de_osso"
display_name = "Amuleto de Osso"
description = "+30 de vida máxima, mas você se move 10% mais devagar."
rarity = 1
tags = [&"corpo"]
modifiers = [SubResource("mod_health"), SubResource("mod_speed")]
max_stacks = 2